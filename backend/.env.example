PORT=3200
# Absolute path to the directory holding bare repos (<namespace>/<repo>.git).
REPOS_PATH=/path/to/drei/repos
# Local development default credentials — change user/password in production.
DATABASE_URL=postgres://user:password@localhost:5432/pg
GIT_HTTP_BACKEND=/usr/lib/git-core/git-http-backend
# URL of the TanStack Start client, used to validate sessions for write APIs
# and to report the frontend service state in the system health snapshot.
CLIENT_URL=http://localhost:3000
# Deployment environment name reported by the system health snapshot.
APP_ENV=development
# Optional extra CORS origins (comma-separated) for credentialed browser
# requests. The CLIENT_URL above is always allowed; local dev origins are
# allowed automatically outside production.
# ALLOWED_ORIGINS=https://app.example.com

# Copy to .env and fill in the values. .env is gitignored; this file is not.
#
#   cp .env.example .env
#   openssl rand -base64 32      # for BETTER_AUTH_SECRET
#   openssl rand -base64 24      # for POSTGRES_PASSWORD
#   openssl rand -base64 24      # for GIT_BASIC_AUTH_PASSWORD
#   docker compose up --build
#
# Docker Compose reads this file itself, so a value set here reaches the
# containers without being passed on a command line.

# --- required ---------------------------------------------------------------

# Password for the Postgres role and database.
POSTGRES_PASSWORD=

# Signs session cookies and tokens. Rotating it invalidates every session.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The address users type, scheme and port included. This is the origin
# better-auth validates every sign-in and sign-up against, and the one the
# session cookie belongs to, so it must be exactly the address the browser is
# on:
#
#   http://192.168.1.10:3000     a LAN address
#   http://drei:3000             a hostname on the LAN
#   https://drei.example.com     a domain, usually behind a reverse proxy
#
# There is deliberately no default. A default of localhost is a value that is
# correct only on the server itself, and reaching Drei by any other address
# then fails at sign-in with "Invalid origin" and a 403 that no amount of
# retrying fixes. Nothing here falls back: if this is empty, Compose refuses to
# start and the frontend container refuses to boot.
PUBLIC_URL=

# --- optional, with defaults ------------------------------------------------

POSTGRES_USER=drei
POSTGRES_DB=drei

# Host port the frontend is published on. This is the container port the
# browser reaches, not the address better-auth validates: if you change
# PUBLIC_PORT, put the same port in PUBLIC_URL.
PUBLIC_PORT=3000

# Extra trusted origins, comma separated, only for a deployment that is
# legitimately reachable under more than one address, for example a domain and
# a VPN hostname at the same time:
#
#   BETTER_AUTH_TRUSTED_ORIGINS=https://drei.example.com,http://drei.vpn:3000
#
# Leave it empty otherwise. The origin in PUBLIC_URL is always trusted; this
# only ever adds to that list, and every entry is an origin that may
# authenticate against this deployment, so do not add addresses speculatively.

# Credentials for git over HTTP. `git` does not send browser session cookies,
# so these are what make `git clone` and `git push` work:
#
#   git clone http://USER:PASS@drei:3000/git/OWNER/REPO.git
#
# Leave both empty to disable them; /git/ then accepts session-authenticated
# requests only, which means anonymous clones of public repositories still work
# but pushing does not.
GIT_BASIC_AUTH_USER=
GIT_BASIC_AUTH_PASSWORD=

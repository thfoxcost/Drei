# Client environment contract. Copy to .env and fill in real values.
#
# Split by mode on purpose:
#
#   .env                 server-side secrets and settings (gitignored)
#   .env.development     browser-facing URLs for `vite dev`
#   .env.production      browser-facing URLs for `vite build` (committed)
#
# Only variables prefixed with VITE_ are exposed to the browser. Everything
# else stays on the server.

# ── .env (gitignored) ────────────────────────────────────────────────────────

# The public address of this app, and nothing else. The dev server is on 3000,
# so that is the value here; a deployment serves whatever its own environment
# says, which for Docker Compose is PUBLIC_URL in the repository root .env.
#
# src/lib/auth.ts reads PUBLIC_URL first and BETTER_AUTH_URL as an alias, then
# sets better-auth's baseURL and trustedOrigins from it. That value is the only
# origin sign-in and sign-up accept: a request from any other address is
# rejected with "Invalid origin" before the database is consulted, so this must
# be the address the browser is actually on - not the one the server is.
#
# In production it is required. With NODE_ENV=production, the frontend refuses
# to boot without it, and if the two names are set to different origins it
# refuses to start rather than pick one.
PUBLIC_URL=http://localhost:3000
# BETTER_AUTH_URL=http://localhost:3000   # accepted alias, same value

# Additional trusted origins, comma separated, for a deployment reachable under
# more than one address. better-auth appends these to the origin above. Unset
# everywhere except where it is genuinely needed.
# BETTER_AUTH_TRUSTED_ORIGINS=

# Signing key for sessions and cookies. Generate a fresh value for every
# deployment, for example: openssl rand -base64 32
# Never commit this and never reuse a development value in production.
BETTER_AUTH_SECRET=

# Postgres connection string for better-auth. This is the same database the Go
# backend uses. Note that the production build needs it present, because
# src/lib/auth.ts constructs the connection pool at module scope.
DB_HOST=postgres://user:password@localhost:5432/pg

# ── .env.development (committed) ─────────────────────────────────────────────

# The Go backend's address, needed in development only because the dev server
# (3000) and the backend (3200) are different origins.
VITE_BACKEND_URL=http://localhost:3200

# Origin used to build git clone URLs, which must be absolute. In development
# that is the backend, which serves the /git/ endpoints.
VITE_PUBLIC_URL=http://localhost:3200

# ── .env.production (committed) ──────────────────────────────────────────────

# Empty: the API is on the same origin as this client, so requests are
# origin-relative and the session cookie is sent automatically. Set a value
# only to run the client against a backend on a different origin.
VITE_BACKEND_URL=

# Empty falls back to the browser's current origin, which is correct for a
# same-origin deployment. Set it when the public origin should differ from the
# address the app is served at, to build clone URLs like
# http://drei.lan/git/theFoxCost/test1.git
VITE_PUBLIC_URL=

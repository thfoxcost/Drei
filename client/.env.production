# Loaded by `vite build` only. Committed: it contains no secrets.
#
# BETTER_AUTH_SECRET is deliberately absent. It is read at runtime by the
# server process, not baked into the bundle, so it must be supplied through the
# process environment (a systemd EnvironmentFile, a container env, or
# .env.production.local) and must never be committed.
#
# PUBLIC_URL and BETTER_AUTH_URL are absent for the same reason, and for a
# stronger one: both are read from the process environment at request time by
# src/lib/auth.ts, and the value that reaches the browser is the one the server
# was started with. Putting a deployment's address in a committed file is how a
# stale one ends up outliving the deployment it was written for.
#
# DB_HOST is also absent for the same reason, with one exception: the build
# itself needs it, because src/lib/auth.ts constructs a pg Pool at module
# scope. Provide it in the build environment.

# Empty means "the API is on the same origin as this client", which is the
# production topology: one reverse proxy routes /api, /git and /uploads to the
# Go backend and everything else to this app. Same-origin requests carry the
# session cookie automatically, so no call site needs credentials:"include".
#
# Set this only to run the client against a backend on a different origin.
VITE_BACKEND_URL=

# Absolute public origin, used to build git clone URLs such as
# http://drei.lan/git/theFoxCost/test1.git. Leave empty to use the browser's
# current origin, which is correct whenever the app is reached at the address
# users actually type. Set it explicitly only when the two differ, for example
# behind a proxy that serves the app on a different name than the git endpoint.
VITE_PUBLIC_URL=

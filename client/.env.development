# Loaded by `vite dev` only.
#
# In development the client and the Go backend are on different ports, so they
# are different origins and the backend address has to be spelled out. This is
# the only mode that needs it.
VITE_BACKEND_URL=http://localhost:3200

# Absolute origin used to build git clone URLs, which leave the browser and so
# cannot be origin-relative. In development the git endpoints are served by the
# backend, so this is the backend's address, not the dev server's.
VITE_PUBLIC_URL=http://localhost:3200

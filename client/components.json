{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "radix-nova",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/styles.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "menuColor": "default",
  "menuAccent": "subtle",
  "aliases": {
    "components": "#/components",
    "utils": "#/lib/utils",
    "ui": "#/components/ui",
    "lib": "#/lib",
    "hooks": "#/hooks"
  },
  "registries": {
    "@efferd": "https://efferd.com/r/{name}.json",
    "@ncdai": "https://chanhdai.com/r/{name}.json",
    "@magicui": "https://magicui.design/r/{name}",
    "@reui": "https://reui.io/r/{style}/{name}.json",
    "@soundcn": "https://soundcn.xyz/r/{name}.json",
    "@dotmatrix": "https://dotmatrix.zzzzshawn.cloud/r/{name}.json",
    "@wigggle-ui": "https://wigggle-ui.vercel.app/r/{name}.json",
    "@shadcn-space": "https://shadcnspace.com/r/{name}.json"
  }
}
